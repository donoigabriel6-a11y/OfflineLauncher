{
  "$schema": "https://schema.tauri.app/permission/2",
  "identifier": "fs:allow-app-data",
  "description": "Allow read/write access to app data directory",
  "allow": [
    { "identifier": "fs:allow-read", "path": "$APPDATA/*" },
    { "identifier": "fs:allow-write", "path": "$APPDATA/*" },
    { "identifier": "fs:allow-read", "path": "$HOME/Library/Application Support/*" },
    { "identifier": "fs:allow-write", "path": "$HOME/Library/Application Support/*" },
    { "identifier": "fs:allow-read", "path": "$HOME/.local/share/*" },
    { "identifier": "fs:allow-write", "path": "$HOME/.local/share/*" }
  ]
}