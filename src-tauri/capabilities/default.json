{
  "$schema": "https://schema.tauri.app/capability/2",
  "identifier": "default",
  "description": "Default capabilities for the application",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:app:default",
    "core:event:default",
    "core:menu:default",
    "core:tray:default",
    "core:webview:default",
    "core:cli:default",
    "core:path:default",
    "fs:default",
    "fs:allow-app-data",
    "fs:allow-home",
    "shell:default",
    "shell:allow-java",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:default",
    "process:default",
    "store:default"
  ]
}